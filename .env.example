# Copy to .env for local development. Never commit real secrets.
SERPSCRAP_API_URL=http://127.0.0.1:8000/api/v1
POSTGRES_PASSWORD=replace-with-a-long-random-database-secret
SEARXNG_SECRET=replace-with-a-long-random-searxng-secret
MCP_HOST=127.0.0.1
MCP_PORT=8001
# Required for the MCP gateway, including Docker Compose.
MCP_AUTH_TOKEN=replace-with-a-secret
MCP_MAX_OUTPUT_BYTES=100000
# Optional published-port overrides. Defaults are loopback-only.
# SERPSCRAP_API_BIND=127.0.0.1:8000
# SERPSCRAP_UI_BIND=127.0.0.1:8080
# SERPSCRAP_MCP_BIND=127.0.0.1:8001
# SEARXNG_BIND=127.0.0.1:8888
